  <script>

    /* =========================
       DESIGN SLIDER
    ========================== */

    const slider = document.querySelector('.works__slider');

    const scrollSlide = (direction) => {

      const card = slider.querySelector('.work-card');

      const gap =
        parseFloat(getComputedStyle(slider).gap) || 0;

      slider.scrollBy({
        left: direction * (card.offsetWidth + gap),
        behavior: 'smooth'
      });

    };


    document
      .querySelector('.works__button--prev')
      .addEventListener(
        'click',
        () => scrollSlide(-1)
      );


    document
      .querySelector('.works__button--next')
      .addEventListener(
        'click',
        () => scrollSlide(1)
      );



    let isDragging = false;

    let dragStartX = 0;

    let dragStartScroll = 0;

    let hasDragged = false;



    slider.addEventListener(
      'pointerdown',
      (event) => {

        isDragging = true;

        dragStartX = event.clientX;

        dragStartScroll = slider.scrollLeft;

        hasDragged = false;

        slider.setPointerCapture(
          event.pointerId
        );

        slider.classList.add(
          'is-dragging'
        );

      }
    );



    slider.addEventListener(
      'pointermove',
      (event) => {

        if (!isDragging) return;

        if (Math.abs(event.clientX - dragStartX) > 6) {
          hasDragged = true;
        }

        slider.scrollLeft =
          dragStartScroll -
          (event.clientX - dragStartX);

      }
    );



    const stopDragging = () => {

      isDragging = false;

      slider.classList.remove(
        'is-dragging'
      );

    };


    slider.addEventListener(
      'pointerup',
      stopDragging
    );

    slider.addEventListener(
      'pointercancel',
      stopDragging
    );


    slider.addEventListener(
      'click',
      (event) => {
        if (!hasDragged) return;

        event.preventDefault();
        hasDragged = false;
      },
      true
    );


    /* LUMORA screen switcher and focused UI previews */
    const lumoraProject = document.querySelector('.lumora-project');
    const lumoraTabs = [...lumoraProject.querySelectorAll('[data-lumora-tab]')];
    const lumoraPanels = [...lumoraProject.querySelectorAll('[data-lumora-panel]')];

    const showLumoraScreen = (tabToShow, moveFocus = false) => {
      lumoraTabs.forEach((tab) => {
        const active = tab === tabToShow;
        tab.setAttribute('aria-selected', String(active));
        tab.tabIndex = active ? 0 : -1;
        if (active && moveFocus) tab.focus();
      });

      lumoraPanels.forEach((panel) => {
        panel.hidden = panel.dataset.lumoraPanel !== tabToShow.dataset.lumoraTab;
      });
    };

    lumoraTabs.forEach((tab, index) => {
      tab.addEventListener('click', () => showLumoraScreen(tab));
      tab.addEventListener('keydown', (event) => {
        let nextIndex = index;
        if (event.key === 'ArrowRight') nextIndex = (index + 1) % lumoraTabs.length;
        else if (event.key === 'ArrowLeft') nextIndex = (index - 1 + lumoraTabs.length) % lumoraTabs.length;
        else if (event.key === 'Home') nextIndex = 0;
        else if (event.key === 'End') nextIndex = lumoraTabs.length - 1;
        else return;

        event.preventDefault();
        showLumoraScreen(lumoraTabs[nextIndex], true);
      });
    });

    const lumoraPreview = document.getElementById('lumoraPreview');
    const lumoraPreviewContent = lumoraPreview.querySelector('.lumora-modal__content');
    const lumoraPreviewTitle = document.getElementById('lumoraPreviewTitle');
    const lumoraClose = lumoraPreview.querySelector('[data-lumora-close]');
    let lumoraLastTrigger = null;

    lumoraProject.querySelectorAll('[data-lumora-preview]').forEach((trigger) => {
      trigger.addEventListener('click', () => {
        if (typeof lumoraPreview.showModal !== 'function') return;
        lumoraLastTrigger = trigger;
        lumoraPreviewTitle.textContent = trigger.dataset.previewTitle;
        lumoraPreviewContent.replaceChildren(trigger.querySelector('.lumora-shot').cloneNode(true));
        lumoraPreview.showModal();
        lumoraClose.focus();
      });
    });

    lumoraClose.addEventListener('click', () => lumoraPreview.close());
    lumoraPreview.addEventListener('click', (event) => {
      if (event.target === lumoraPreview) lumoraPreview.close();
    });
    lumoraPreview.addEventListener('close', () => {
      lumoraPreviewContent.replaceChildren();
      if (lumoraLastTrigger) lumoraLastTrigger.focus();
    });

  </script>

